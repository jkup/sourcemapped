{
  "name": "@jkup/sourcemapped",
  "version": "0.1.1",
  "description": "Explore the public source maps behind a website's JavaScript.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jkup/sourcemapped.git"
  },
  "bin": {
    "sourcemapped": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc",
    "demo": "npm run --silent build && node examples/demo/run.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "pretest": "npm run build",
    "test": "vitest run",
    "check": "npm run typecheck && npm run check:docs && npm test",
    "check:docs": "node scripts/check-docs.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "htmlparser2": "^12.0.0",
    "maplint": "0.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "author": "Jon Kuperman",
  "homepage": "https://github.com/jkup/sourcemapped",
  "bugs": {
    "url": "https://github.com/jkup/sourcemapped/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
